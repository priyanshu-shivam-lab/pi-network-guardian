# Pi Network Guardian – Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# Network
GATEWAY_IP=192.168.1.1
PORT=3000

# SMTP Email Settings
# For Gmail: use smtp.gmail.com, port 587, SMTP_SECURE=false
# and generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin alert recipient
ADMIN_EMAIL=admin@yourdomain.com

# Minutes the servers' own shutdown script waits with the gateway unreachable
# before shutting down. Used to infer from outage length whether servers shut down.
SERVER_SHUTDOWN_AFTER_MIN=5

# Stop sending Wake-on-LAN to a server that hasn't come up after this many minutes,
# and email the admin that it needs manual intervention.
WOL_GIVE_UP_MIN=10
